<Window x:Class="MovieApp.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MovieApp.Views"
        mc:Ignorable="d"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="CinemaApp" MinHeight="500" MinWidth="500" Height="600" Width="800" WindowStyle="None">
   
    <Grid MouseDown="Grid_MouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Border>
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource Primary900Foreground}"/>
                </Border.Background>
            </Border>

            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button 
                Click="Minimize_Click"
                Name="Minimize"
                Style="{DynamicResource MaterialDesignFlatButton}">
                    <md:PackIcon Kind="Minimize"/>
                </Button>

                <Button 
                Click="Maximize_Click"
                Name="Maximize"
                Style="{DynamicResource MaterialDesignFlatButton}">
                    <md:PackIcon Kind="Maximize"/>
                </Button>

                <Button 
                Click="Close_Click"
                Name="Close"
                Style="{DynamicResource MaterialDesignFlatButton}">
                    <md:PackIcon Kind="Close"/>
                </Button>
            </StackPanel>
        </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Width="100" Grid.Row="1">

            <Button Style="{StaticResource MaterialDesignFlatDarkButton}">
                <md:PackIcon Kind="Login"/>
            </Button>

            <Button Style="{StaticResource MaterialDesignFlatDarkButton}">
                <md:PackIcon Kind="Register"/>
            </Button>
        </StackPanel>
        
        <ContentControl Content="{Binding CurrentView}" Grid.Row="2"/>
    </Grid>
</Window>
